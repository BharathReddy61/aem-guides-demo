<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
    jcr:description="Authorable promotional carousel for the FoodApp home page."
    jcr:primaryType="cq:Component"
    jcr:title="Food Banner Carousel"
    componentGroup="DEMO - CONTENT"
    food-banner-carousel-original-htl="&#xa;&lt;sly data-sly-use.clientlib=&quot;/libs/granite/sightly/templates/clientlib.html&quot;&#xa;     data-sly-call=&quot;${clientlib.all @ categories='demo.food-banner-carousel'}&quot;/>&#xa;&#xa;&lt;section class=&quot;food-banner-carousel&quot;&#xa;         data-food-banner-carousel&#xa;         aria-label=&quot;Promotional offers&quot;>&#xa;&#xa;    &lt;sly data-sly-test.slidesResource=&quot;${resource.getChild('slides')}&quot;>&lt;/sly>&#xa;    &lt;div class=&quot;food-banner-carousel__slides&quot;&#xa;         data-sly-test=&quot;${slidesResource}&quot;>&#xa;&#xa;        &lt;article class=&quot;food-banner-carousel__slide&quot;&#xa;                 data-sly-list.slide=&quot;${slidesResource.children}&quot;&#xa;                 data-slide-index=&quot;${slideList.index}&quot;&#xa;                 aria-hidden=&quot;${!slideList.first}&quot;>&#xa;&#xa;            &lt;div class=&quot;food-banner-carousel__background&quot;&#xa;                 data-sly-test=&quot;${slide.image}&quot;&#xa;                 style=&quot;background-image: url('${slide.image @ context='uri'}')&quot;>&#xa;            &lt;/div>&#xa;&#xa;            &lt;div class=&quot;food-banner-carousel__content&quot;>&#xa;                &lt;h2>${slide.title}&lt;/h2>&#xa;                &lt;p data-sly-test=&quot;${slide.description}&quot;>&#xa;                    ${slide.description}&#xa;                &lt;/p>&#xa;&#xa;                &lt;a class=&quot;food-banner-carousel__cta&quot;&#xa;                   data-sly-test=&quot;${slide.ctaText &amp;&amp; slide.ctaLink}&quot;&#xa;                   href=&quot;${slide.ctaLink @ context='uri'}&quot;>&#xa;                    ${slide.ctaText}&#xa;                &lt;/a>&#xa;            &lt;/div>&#xa;        &lt;/article>&#xa;    &lt;/div>&#xa;&#xa;    &lt;div class=&quot;food-banner-carousel__empty&quot;&#xa;         data-sly-test=&quot;${!resource.getChild('slides') ||&#xa;                          !resource.getChild('slides').hasNodes}&quot;>&#xa;        &lt;p>Configure promotional slides in the component dialog.&lt;/p>&#xa;    &lt;/div>&#xa;&#xa;    &lt;button class=&quot;food-banner-carousel__arrow food-banner-carousel__prev&quot;&#xa;            type=&quot;button&quot; aria-label=&quot;Previous promotion&quot;&#xa;            data-carousel-prev>&#xa;        &amp;#10094;&#xa;    &lt;/button>&#xa;&#xa;    &lt;button class=&quot;food-banner-carousel__arrow food-banner-carousel__next&quot;&#xa;            type=&quot;button&quot; aria-label=&quot;Next promotion&quot;&#xa;            data-carousel-next>&#xa;        &amp;#10095;&#xa;    &lt;/button>&#xa;&#xa;    &lt;div class=&quot;food-banner-carousel__dots&quot;&#xa;         data-carousel-dots&#xa;         aria-label=&quot;Choose a promotion&quot;>&lt;/div>&#xa;&lt;/section>&#xa;"/>
